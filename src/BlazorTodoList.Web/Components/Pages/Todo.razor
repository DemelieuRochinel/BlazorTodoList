@page "/Todo"
@rendermode InteractiveServer

<PageTitel>Todo</PageTitel>

<h3>Todo List for notes</h3>

<ul>
    @foreach(var todo in todos)
    {
        <li>todo.Titel</li>
    }
</ul>

<input placeholder="what task are going to work on? " />
<button>Add todo</button>



@code{

    private List<TodoItem> todos = [];

}